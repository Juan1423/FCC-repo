# =============================================================================
#  EJEMPLO DE CONFIGURACIÓN DEL CLIENTE (Frontend - Fundación con Cristo)
# =============================================================================
#  Copia este archivo a ".env" en la carpeta cliente-fc/client/ y rellena el valor.
#
#  IMPORTANTE (2 reglas de Create React App):
#    1) Las variables deben empezar por REACT_APP_ para que la aplicación
#       las pueda leer.
#    2) Se "cocinan" al hacer el BUILD (npm run build). Si cambias este
#       archivo, hay que ejecutar npm run build otra vez; no basta con
#       refrescar la página.
#
#  NO pongas contraseñas ni claves aquí: este archivo es público (viaja
#  dentro del paquete que se descarga el navegador). Solo URLs públicas.
# =============================================================================


# -----------------------------------------------------------------------------
# DIRECCIÓN DEL SERVIDOR (API)
# -----------------------------------------------------------------------------

# QUÉ HACE: Le dice a la página web dónde está el servidor para pedirle datos.
# VALORES:  La dirección COMPLETA del API, sin barra final. Ej.:
#           https://api.fundacion.org
# SI FALTA: Usa http://localhost:5000 (solo sirve para desarrollo local).
# CONSEJO:  - En tu PC de trabajo: déjala vacía o en http://localhost:5000.
#           - En producción: pon la dirección REAL del servidor. Si no la
#             pones, la página hablará con localhost y no cargará nada.
#           - Debe coincidir con lo que el servidor acepta en
#             CORS_ALLOWED_ORIGINS: el servidor solo acepta páginas que él
#             conoce, y esta variable le dice a la página dónde pedir.
REACT_APP_API_URL=http://localhost:5000