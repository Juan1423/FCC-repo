# =============================================================================
#  EJEMPLO DE CONFIGURACIÓN DEL SERVIDOR (Fundación con Cristo - Backend)
# =============================================================================
#  Copia este archivo a ".env" y rellena los valores con TU configuración.
#  NO subas el ".env" real al repositorio: contiene secretos.
#
#  Leyenda de cada variable:
#    QUÉ HACE  -> para qué sirve, en palabras simples.
#    VALORES   -> qué se puede poner.
#    SI FALTA  -> qué pasa si no se configura (o se borra).
#    CONSEJO   -> recomendación práctica.
# =============================================================================


# -----------------------------------------------------------------------------
# PUERTO Y URL DEL SERVIDOR
# -----------------------------------------------------------------------------

# QUÉ HACE: El puerto donde se levanta el API (el número que va en :5000).
# VALORES:  Un número de puerto libre (ej. 5000, 8080).
# SI FALTA: Usa 5000 por defecto.
PORT=5000

# QUÉ HACE: La dirección pública que se muestra en la documentación (Swagger).
# VALORES:  URL completa, ej. https://api.fundacion.org
# SI FALTA: Usa http://localhost:5000 (solo sirve para desarrollo local).
BASE_URL=http://localhost:5000


# -----------------------------------------------------------------------------
# MODO DE EJECUCIÓN
# -----------------------------------------------------------------------------

# QUÉ HACE: Le dice al servidor si está en desarrollo o en producción.
#           - En "production" la cookie de sesión se marca como "solo HTTPS"
#             (el navegador solo la guarda si el sitio es https).
#           - En "development" se activan los registros detallados.
# VALORES:  development | production | (vacío)
# SI FALTA: Trata todo como desarrollo: cookie NO segura, logs detallados.
# CONSEJO:  En tu PC de trabajo déjala vacía o en "development".
#           En el servidor real póngala en "production" PERO SOLO si el API
#           está detrás de HTTPS. Si la pones en production sin HTTPS,
#           el login parecerá funcionar pero la sesión NO se guarda y todo
#           se ve "roto".
NODE_ENV=development

# QUÉ HACE: Publica (o no) la documentación interactiva Swagger en /api-docs.
# VALORES:  true | false
# SI FALTA: En desarrollo queda habilitada; en producci��n queda DESHABILITADA.
# CONSEJO:  Déjala en false en producción para no exponer endpoints, parámetros
#           ni modelos internos. Actívala solo de forma temporal y con acceso
#           restringido por red/VPN.
ENABLE_API_DOCS=false


# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# -----------------------------------------------------------------------------

# QUÉ HACE: Conexión a tu base de datos (usuario, contraseña, nombre, servidor y puerto).
# VALORES:  Dependen de tu instalación de PostgreSQL.
# SI FALTA: El servidor no puede conectarse a la base de datos y falla al arrancar.
DB_USER=fundacionconcristo
DB_PASSWORD=TU_CONTRASENA_SEGURA
DB_DATABASE=base_fcc_v1
DB_HOST=localhost
DB_PORT=5432


# -----------------------------------------------------------------------------
# CLAVE SECRETA PARA LAS SESIONES (JWT)
# -----------------------------------------------------------------------------

# QUÉ HACE: La "firma" que usa el servidor para crear y verificar las sesiones
#           de los usuarios. Si alguien la conoce, puede falsificar sesiones.
# VALORES:  Un texto largo y aleatorio (mínimo 32 caracteres). Ej.:
#           "c9f2b8a1e7d34f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9"
# SI FALTA: El servidor arranca pero el login falla (no puede firmar tokens).
# CONSEJO:  Genérala una vez y NUNCA la cambies: si la cambias, todos los
#           usuarios quedan con la sesión cerrada y deben volver a iniciar sesión.
JWT_SECRET=TU_SECRETO_LARGO_Y_ALEATORIO

# QUÉ HACE: Cuánto tiempo dura una sesión iniciada.
# VALORES:  Número + unidad: 30m (minutos), 2h (horas), 8h, 1d (días).
# SI FALTA: Usa 2h.
# CONSEJO:  Más corto = más seguro (una sesión robada sirve menos tiempo),
#           pero más molesto (los usuarios se desloguean antes).
#           Si la cambias, solo afecta a las sesiones NUEVAS; las ya abiertas
#           mantienen su duración original.
JWT_EXPIRES_IN=2h

# QUÉ HACE: "Etiqueta" que identifica qué aplicación emitió la sesión y para
#           qué aplicación va destinada. Es una protección extra: si algún día
#           dos aplicaciones compartieran la misma clave secreta, una sesión
#           de una no serviría en la otra.
# VALORES:  Textos cortos, ej. fcc y fcc-web (los valores por defecto).
# SI FALTA: Usa fcc y fcc-web por defecto.
# CONSEJO:  DÉJALOS como están. Si los cambias, TODAS las sesiones abiertas
#           quedan inválidas de inmediato (todos vuelven a iniciar sesión).
JWT_ISSUER=fcc
JWT_AUDIENCE=fcc-web


# -----------------------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL (Chatbot)
# -----------------------------------------------------------------------------

# QUÉ HACE: Claves para usar OpenAI (respuestas del chatbot) y CIE-11 (buscador
#           de enfermedades).
# SI FALTA: El chatbot o el buscador CIE-11 fallan con error de autenticación.
OPENAI_API_KEY=TU_CLAVE_OPENAI
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
CIE11_CLIENT_ID=TU_CLIENT_ID
CIE11_CLIENT_SECRET=TU_CLIENT_SECRET


# -----------------------------------------------------------------------------
# NEW RELIC (monitoreo de errores del servidor)
# -----------------------------------------------------------------------------

# QUÉ HACE: New Relic vigila errores y rendimiento del servidor.
# VALORES:  NEW_RELIC_APP_NAME: nombre que identifica a esta app en New Relic.
#           NEW_RELIC_LICENSE_KEY: tu clave de licencia.
# SI FALTA: El servidor funciona normal, pero New Relic muestra un error en
#           cada arranque. Si NO usas New Relic, puedes dejar esto vacío
#           (o quitar la línea "require('newrelic')" de app.js).
NEW_RELIC_APP_NAME=fundacion-backend
NEW_RELIC_LICENSE_KEY=TU_LICENCIA


# -----------------------------------------------------------------------------
# CORS (qué páginas web tienen permiso de hablar con el API)
# -----------------------------------------------------------------------------

# QUÉ HACE: Lista de páginas web (orígenes) permitidas para usar este API.
#           Es un "portero": cualquier otra página recibe un error de
#           "origen no permitido".
# VALORES:  URLs separadas por coma, SIN barra al final. Ej.:
#           https://app.fundacion.org,https://admin.fundacion.org
# SI FALTA: Usa http://localhost:3000 y http://127.0.0.1:3000 (desarrollo local).
# CONSEJO:  En producción, pon AQUÍ la dirección EXACTA de tu página web.
#           Si te olvidas de una, esa página no podrá iniciar sesión.
#           Es obligatorio para que la sesión (cookie) funcione entre dominios.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# -----------------------------------------------------------------------------
# COOKIE DE SESIÓN (hasta dónde "viaja" la cookie)
# -----------------------------------------------------------------------------

# QUÉ HACE: Controla cuándo el navegador envía la cookie de sesión a sitios
#           que NO son el tuyo.
#   lax    -> La cookie viaja a tu propio sitio y cuando el usuario hace clic
#             en un enlace desde fuera. Es la opción equilibrada y segura.
#   strict -> La cookie SOLO viaja dentro de tu sitio. Más segura aún, pero
#             puede romper enlaces que el usuario recibe por correo/WhatsApp.
#   none   -> La cookie viaja a TODOS los sitios. SOLO debe usarse si tu página
#             y el API están en dominios totalmente distintos, y exige HTTPS.
#             Peligroso: abre la puerta a ataques CSRF (páginas maliciosas
#             que actúan en nombre del usuario).
# SI FALTA: Usa lax.
# CONSEJO:  Déjala en lax. Si algún día pones "none", avisa al equipo de
#           desarrollo: hay que añadir protección CSRF.
COOKIE_SAME_SITE=lax


# -----------------------------------------------------------------------------
# PROXY (intermediario entre el usuario y el servidor)
# -----------------------------------------------------------------------------

# QUÉ HACE: Cuántos "intermediarios" (nginx, Cloudflare, balanceador) hay
#           delante del servidor. Sirve para que el servidor vea la IP REAL
#           del usuario (necesaria para los límites de uso y bloqueos).
# VALORES:  Un número (habitualmente 1 si hay un nginx delante) o vacío.
# SI FALTA: Vacío = el servidor usa la IP del intermediario. Si hay proxy,
#           todos los usuarios comparten la misma IP y los límites se rompen.
# CONSEJO:  Déjala vacía si el servidor está expuesto directo.
#           Pon 1 si hay un nginx/balanceador delante. NO pongas número si no
#           hay proxy: un atacante podría inventarse la IP y saltarse límites.
TRUST_PROXY_HOPS=


# -----------------------------------------------------------------------------
# LÍMITES DE USO DEL CHAT (seguridad anti-abuso)
# -----------------------------------------------------------------------------

# QUÉ HACE: Cuántas preguntas de chat puede hacer un visitante anónimo por DÍA
#           y por dirección IP (no por persona: por red/equipo).
#           Es un "piso" de seguridad: aunque un atacante cambie de identidad
#           a cada pregunta, la IP lo delata.
# VALORES:  Un número entero. Ej. 50 (default), 100, 200.
# SI FALTA: Usa 50.
# CONSEJO:  No lo pongas en 0 (0 = sin límite y deja la puerta abierta).
#           Este tope va aparte del que se ajusta desde la pantalla de
#           configuración del chatbot (ese es por visitante y sí se puede
#           cambiar desde la web; este es por IP y solo se cambia aquí).
RATE_LIMIT_VISITANTE_IP_DIARIO=50


# -----------------------------------------------------------------------------
# REGISTROS (logs)
# -----------------------------------------------------------------------------

# QUÉ HACE: Tamaño máximo del archivo de registros (logs/app.log) y nivel de
#           detalle.
# VALORES:  LOGGING_MAX_MB: número (MB). LOGGING_DETAILED: true/false.
# SI FALTA: 5 MB y detalle según NODE_ENV.
LOGGING_MAX_MB=5
LOGGING_DETAILED=false


# -----------------------------------------------------------------------------
# OPCIONALES DEL CHATBOT (personalización de la marca)
# -----------------------------------------------------------------------------
# QUÉ HACE: Nombre, misión, teléfono, redes sociales, horarios, etc. que usa
#           el chatbot para responder sobre la Fundación.
# SI FALTA: Usa los valores de ejemplo de "Fundación con Cristo".
# FUNDACION_NOMBRE=Fundación con Cristo
# FUNDACION_MISION=Proporcionar servicios de salud integral...
# FUNDACION_TELEFONO=(+593) 2 2500000
# FUNDACION_EMAIL=info@fundacionconcristo.org.ec
# FUNDACION_SITIO_WEB=www.fundacionconcristo.org.ec
# FUNDACION_CIUDAD_PRINCIPAL=Quito
# FUNDACION_PROVINCIA=Pichincha
# FUNDACION_PAIS=Ecuador
# FUNDACION_HORARIO_LV=08:00 - 18:00
# FUNDACION_HORARIO_SAB=08:00 - 13:00
# FUNDACION_HORARIO_DOM=Cerrado


# -----------------------------------------------------------------------------
# BLOQUEO DE IP (opcional)
# -----------------------------------------------------------------------------
# QUÉ HACE: Lista de direcciones IP bloqueadas (no pueden usar el sistema).
# VALORES:  Lista JSON entre corchetes: ["1.2.3.4","5.6.7.8"]
# SI FALTA: Ninguna IP bloqueada.
# BLOCKED_IPS=["1.2.3.4"]